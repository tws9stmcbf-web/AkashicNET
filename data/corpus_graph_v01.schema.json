{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tws9stmcbf-web/AkashicNET/blob/main/data/corpus_graph_v01.schema.json",
  "title": "AkashicNET Corpus Graph v0.1",
  "type": "object",
  "required": ["schema_version", "nodes", "edges"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "label"],
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["source", "folder", "file", "work", "edition", "author", "tradition", "domain", "concept", "claim", "evidence", "discussion", "application"]},
          "label": {"type": "string"},
          "provenance": {"type": "object", "properties": {"drive_id": {"type": "string"}, "path": {"type": "string"}, "filename": {"type": "string"}, "created_at": {"type": "string"}, "modified_at": {"type": "string"}}, "additionalProperties": true},
          "epistemic_class": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "metadata": {"type": "object", "additionalProperties": true}
        },
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "relation", "target"],
        "properties": {
          "source": {"type": "string"},
          "relation": {"enum": ["CONTAINS", "REPRESENTS", "HAS_EDITION", "CREATED_BY", "ASSOCIATED_WITH", "CLASSIFIED_AS", "MENTIONS", "EXTRACTED_FROM", "SUPPORTED_BY", "CONTRADICTED_BY", "DISCUSSES", "DERIVED_FROM", "DUPLICATE_OF", "SAME_WORK_AS", "RELATES_TO"]},
          "target": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "provenance": {"type": "object", "additionalProperties": true}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
