  "construct": {
    "latent_construct": "awareness_during_a_bounded_resuscitation_interval",
    "primary_observable": "locked_later_report_and_correspondence_with_independently_timed_information",
    "measurement_relation": "indirect_proxy_not_direct_observation",
    "excluded_as_primary": [
      "broad_consciousness",
      "sentience",
      "personal_survival",
      "afterlife"
    ],
    "continuity_definition": "hypothesized temporal relation between a documented resuscitation interval and later reportable content; not directly measured",
    "temporal_alternatives": [
      "encoding_during_cpr",
      "peri_arrest_encoding",
      "post_rosc_encoding",
      "temporal_misattribution"
    ],
    "interpretation_constraint": "target correspondence alone does not establish awareness, continuity, personal survival or afterlife"
  },
  "research_question": "Can specific later reports be matched to independently timed information from documented cardiac-arrest/resuscitation intervals, under conditions designed to reduce, measure and test ordinary visual access, retrospective cueing, temporal misattribution and post-event information leakage?",
  "stages": [
    {
      "id": 0,
      "label": "protocol_construction",
      "participant_recruitment": false,
      "truth_inference": false
    },
    {
      "id": 1,
      "label": "multi_site_feasibility_pilot",
      "provisional_sites": "3-5",
      "provisional_eligible_events": "150-300",
      "primary_outcome": "protocol_feasibility"
    },
    {
      "id": 2,
      "label": "confirmatory_multi_site_study",
      "start_condition": "all mandatory Stage-1 gates pass and independent review, ethics approvals, registration and simulation-based sample size are complete"
    }
  ],
  "analysis_populations": [
    "ALL_ELIGIBLE_EVENTS",
    "ALL_SURVIVORS",
    "ALL_APPROACH_ELIGIBLE",
    "ALL_INTERVIEWED",
    "TARGET_EXPOSED",
    "VISUAL_CLAIM",
    "PER_PROTOCOL_TARGET_EXPOSED"
  ],
  "stage_2_primary_hypothesis": {
    "population": "TARGET_EXPOSED",
    "outcome": "pre-registered true-versus-decoy time-aligned visual target score",
    "null": "true and decoy assignments are exchangeable",
    "alternative": "true time-aligned sequences receive higher scores than the frozen randomization distribution",
    "interpretation_constraint": "correspondence_endpoint_does_not_by_itself_establish_awareness_or_continuity"
  },
  "feasibility_gates": [
    {
      "id": "G01_COMPLETE_EVENT_DENOMINATOR",
      "numerator": "eligible_events_with_stable_id_and_all_minimum_eligibility_fields",
      "denominator": "all_eligible_events_independently_identified_from_hospital_arrest_source",
      "threshold": ">=98%",
      "mandatory": true,
      "unknown_handling": "failure"
    },
    {
      "id": "G02_RECOVERABLE_DEVICE_STATUS",
      "numerator": "eligible_events_with_authenticated_device_state_covering_event_window",
      "denominator": "ALL_ELIGIBLE_EVENTS",
      "threshold": ">=98%",
      "mandatory": true,
      "unknown_handling": "failure"
    },
    {
      "id": "G03_VALID_TARGET_ACTIVATION",
      "numerator": "equipped_eligible_events_with_auditable_target_display_in_prespecified_interval",
      "denominator": "eligible_events_with_commissioned_device_expected_operational_at_event_onset",
      "threshold": ">=85%",
      "mandatory": true,
      "unknown_handling": "failure"
    },
    {
      "id": "G04_COMPLETE_TARGET_LOGS",
      "numerator": "activation_sessions_with_complete_canonical_records_valid_chain_signature_and_closing_digest",
      "denominator": "all_activation_sessions_initiated_for_eligible_events",
      "threshold": ">=95%",
      "mandatory": true,
      "unknown_handling": "failure"
    },
    {
      "id": "G05_CLOCK_SYNCHRONIZATION",
      "numerator": "valid_activations_aligned_within_plus_or_minus_1_second_including_uncertainty",
      "denominator": "valid_activations_with_target_session",
      "threshold": ">=95%",
      "mandatory": true,
      "unknown_handling": "failure"
    },
    {
      "id": "G06_TRANSCRIPT_LOCK_BEFORE_UNBLINDING",
      "numerator": "completed_interviews_locked_before_any_target_or_event_log_release",
      "denominator": "all_completed_research_interviews_after_eligible_events",
      "threshold": "100%",
      "mandatory": true,
      "zero_denominator": "NOT_EVALUABLE",
      "critical_hold": "premature_unblinding"
    },
    {
      "id": "G07_CRITICAL_INTERVIEWER_UNBLINDING",
      "numerator": "completed_interviews_with_confirmed_critical_interviewer_unblinding_before_lock",
      "denominator": "all_completed_research_interviews_after_eligible_events",
      "threshold": "<=2%",
      "mandatory": true,
      "zero_denominator": "NOT_EVALUABLE",
      "unresolved_incident": "HOLD"
    },
    {
      "id": "G08_CONTAMINATION_AUDIT_COMPLETE",
      "numerator": "completed_interviews_with_all_frozen_exposure_fields_complete_or_explicitly_unknown",
      "denominator": "all_completed_research_interviews_after_eligible_events",
      "threshold": ">=95%",
      "mandatory": true,
      "blank_handling": "failure"
    },
    {
      "id": "G09_DUAL_CODER_COVERAGE",
      "numerator": "scorable_locked_reports_independently_coded_by_two_qualified_blinded_coders",
      "denominator": "all_reports_declared_scorable_before_target_unblinding",
      "threshold": "100%",
      "mandatory": true,
      "zero_denominator": "NOT_EVALUABLE"
    },
    {
      "id": "G10_CATEGORICAL_AGREEMENT",
      "statistic": "Cohens_kappa",
      "data": "all_eligible_dual_coded_primary_categorical_fields",
      "threshold": ">=0.80",
      "mandatory": true,
      "insufficient_variance": "NOT_EVALUABLE"
    },
    {
      "id": "G11_CONTINUOUS_AGREEMENT",
      "statistic": "frozen_ICC_form",
      "data": "all_eligible_dual_coded_primary_continuous_scores",
      "threshold": ">=0.90",
      "mandatory": true,
      "insufficient_variance": "NOT_EVALUABLE"
    },
    {
      "id": "G12_SERIOUS_DEVICE_RELATED_ADVERSE_EVENTS",
      "numerator": "confirmed_serious_device_related_adverse_events",
      "denominator": "ALL_ELIGIBLE_EVENTS",
      "threshold": "0",
      "mandatory": true,
      "any_event": "HOLD"
    },
    {
      "id": "G13_RESUSCITATION_INTERFERENCE",
      "numerator": "confirmed_instances_study_activity_delayed_obstructed_or_altered_resuscitation",
      "denominator": "ALL_ELIGIBLE_EVENTS",
      "threshold": "0",
      "mandatory": true,
      "any_event": "HOLD"
    },
    {
      "id": "G14_INTERVIEW_WITHDRAWAL_BURDEN",
      "numerator": "approached_survivors_who_begin_then_withdraw_due_to_study_burden",
