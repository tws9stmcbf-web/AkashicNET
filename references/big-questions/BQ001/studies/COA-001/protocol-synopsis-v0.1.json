      "mandatory": true,
      "unknown_handling": "failure"
    },
    {
      "id": "ENCRYPTED_PACKAGE_RECOVERY",
      "numerator": "activations_with_authenticated_recoverable_evidence_package",
      "denominator": "all_activations",
      "threshold": ">=98%",
      "mandatory": true,
      "unknown_handling": "failure"
    },
    {
      "id": "INDEPENDENT_DISPLAY_VERIFICATION",
      "numerator": "activations_with_independent_evidence_intended_pixels_displayed_for_logged_interval",
      "denominator": "all_claimed_valid_exposures",
      "threshold": "freeze_after_commissioning",
      "mandatory": true,
      "render_acknowledgement_alone": "insufficient"
    },
    {
      "id": "BLINDING_ASSESSMENT",
      "numerator": "required_staff_cases_with_completed_frozen_blinding_assessment",
      "denominator": "all_staff_cases_for_whom_assessment_required",
