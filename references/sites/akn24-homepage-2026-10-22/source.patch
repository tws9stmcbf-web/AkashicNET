+import cards from './newsroom-oct21.json' with { type: 'json' };
+
+// Public report records already rendered in /akn24/BriefingOct21.
+// Keep these labels verbatim: source, publication, correction and bulletin dates differ.
+export const newsroomEdition = { label: '21 October 2026', dateTime: '2026-10-21', href: '/akn24#briefing-2026-10-21' };
+export const newsroomStories = Object.entries(cards).map(([id, card]) => ({
+  href: `/akn24#${id === 'forecast' ? 'space-weather-2026-10-21' : id}`,
+  title: card.title,
+  description: card.summary,
+  dateLabel: card.date,
+  evidence: card.tag,
+  sourceUrl: card.url,
+  source: card.source,
+  text: [card.observed, card.interpretation, card.hypothesis, card.testimony, card.speculation, card.unresolved, card.source].join(' '),
+  kind: 'report',
+}));
