+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { createTestWorker } from './worker-runtime.mjs';
+import { newsroomStories } from '../lib/newsroom-stories.mjs';
+
+test('homepage renders the newsroom, dated reports and source links before longer features', async t => {
+  const worker = createTestWorker();
+  t.after(() => worker.dispose());
+  const response = await worker.dispatchFetch('https://akashicnet.org/', { headers: { accept: 'text/html' } });
+  assert.equal(response.status, 200);
+  const html = await response.text();
+  const desk = html.match(/<section id="newsroom-stories"[\s\S]*?<\/section>/)?.[0];
+  assert.ok(desk);
+  assert.ok(html.indexOf('id="psy-radio"') < html.indexOf('id="newsroom-stories"'));
+  assert.ok(html.indexOf('id="newsroom-stories"') < html.indexOf('id="latest-highlights"'));
+  assert.match(html, /<img[^>]+src="\/images\/akn24-pachamama-newsroom-v2.webp"[^>]+fetchPriority="high"/i);
+  for (const story of newsroomStories) {
+    assert.ok(desk.includes(`href="${story.href}"`));
+    assert.ok(desk.includes(`href="${story.sourceUrl}"`));
+    assert.ok(desk.includes(story.dateLabel));
+    assert.ok(desk.includes(story.evidence));
+  }
+  assert.doesNotMatch(html, /<iframe[^>]+(?:youtube|soundcloud|mixcloud|podcasts\.apple)/i, 'players require an explicit choice');
+  const newsroomResponse = await worker.dispatchFetch('https://akashicnet.org/akn24', { headers: { accept: 'text/html' } });
+  assert.equal(newsroomResponse.status, 200);
+  const newsroom = await newsroomResponse.text();
+  for (const story of newsroomStories) assert.ok(newsroom.includes(`id="${story.href.split('#')[1]}"`));
+});
