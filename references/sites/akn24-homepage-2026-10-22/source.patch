+/** @typedef {{href: string, title: string, description: string, text: string, evidence?: string, dateLabel?: string, source?: string, kind?: string}} SearchEntry */
+/** @param {string} value */
+export const fold = value => value.toLocaleLowerCase('en-GB').normalize('NFD').replace(/[\u0300-\u036f]/g, '');
+
+/** @param {ReadonlyArray<SearchEntry>} entries @param {string} query */
+export function searchPages(entries, query) {
+  const words = fold(query.trim()).split(/\s+/).filter(Boolean);
+  if (!words.length) return [];
+  return entries.map(item => {
+    const title = fold(item.title);
+    const description = fold(item.description);
+    const route = fold(item.href.replaceAll('-', ' ').replaceAll('/', ' '));
+    const text = fold([item.text, item.evidence || '', item.dateLabel || '', item.source || ''].join(' '));
+    const score = words.every(word => title.includes(word) || route.includes(word) || description.includes(word) || text.includes(word))
+      ? words.reduce((total, word) => total + (title.includes(word) ? 10 : 0) + (route.includes(word) ? 5 : 0) + (description.includes(word) ? 3 : 0) + (text.includes(word) ? 1 : 0), 0)
+      : 0;
+    return { item, score };
+  }).filter(({ score }) => score > 0).sort((a, b) => b.score - a.score || a.item.title.localeCompare(b.item.title));
+}
+
+/** @param {string} text @param {string} query */
+export function excerptFor(text, query) {
+  const clean = text.replace(/&(?:amp|quot|apos|nbsp|lt|gt);/g, entity =>
+    ({ '&amp;': '&', '&quot;': '"', '&apos;': "'", '&nbsp;': ' ', '&lt;': '<', '&gt;': '>' })[entity] || entity
+  ).replace(/\s+/g, ' ').trim();
+  const positions = fold(query).split(/\s+/).filter(Boolean).map(word => fold(clean).indexOf(word)).filter(index => index >= 0);
+  if (!positions.length) return '';
+  const hit = Math.min(...positions);
+  let start = Math.max(0, hit - 45);
+  let end = Math.min(clean.length, hit + 105);
+  if (start) start = clean.indexOf(' ', start) + 1 || start;
+  if (end < clean.length) end = clean.lastIndexOf(' ', end) > hit ? clean.lastIndexOf(' ', end) : end;
+  return `${start ? '…' : ''}${clean.slice(start, end).trim()}${end < clean.length ? '…' : ''}`;
+}
