+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { readFile } from 'node:fs/promises';
+import { searchPages } from '../lib/public-search.mjs';
+import { newsroomStories } from '../lib/newsroom-stories.mjs';
+import { publicPages, unlistedRoutes } from '../scripts/site-routes.mjs';
+
+test('search finds report body terms that are absent from page-only titles', () => {
+  const results = searchPages(newsroomStories, 'multiplicity');
+  assert.equal(results.length, 1);
+  assert.equal(results[0].item.href, '/akn24#microdosingcorrectionoct21');
+  assert.equal(results[0].item.dateLabel, 'SOURCE 12 OCT · CORRECTED 21 OCT 2026');
+  assert.match(results[0].item.evidence, /CONFERENCE REANALYSIS/);
+  assert.equal(results[0].item.sourceUrl, 'https://www.ecnp.eu/media/wn0lxtb5/lsd-microdosing.pdf');
+});
+
+test('search requires every term and handles blank, absent and accent-insensitive queries', () => {
+  const entries = [{ title: 'Mettā', description: 'Compassion and care', text: '', href: '/metta' }];
+  assert.equal(searchPages(entries, 'metta care').length, 1);
+  assert.equal(searchPages(entries, 'metta missing').length, 0);
+  assert.deepEqual(searchPages(entries, '  '), []);
+  assert.deepEqual(searchPages(entries, 'zzzxxyy'), []);
+});
+
+test('title matches rank above body-only matches without changing source records', () => {
+  const entries = [{ title: 'Other', description: '', text: 'NOAA', href: '/other' }, { title: 'NOAA', description: '', text: '', href: '/noaa' }];
+  const before = JSON.stringify(entries);
+  assert.equal(searchPages(entries, 'NOAA')[0].item.href, '/noaa');
+  assert.equal(JSON.stringify(entries), before);
+});
+
+test('search index only contains the public route inventory', async () => {
+  const source = await readFile(new URL('../lib/site-search.generated.ts', import.meta.url), 'utf8');
+  const entries = JSON.parse(source.slice(source.indexOf(' = ') + 3).replace(/ as const;\s*$/, ''));
+  const routes = new Set((await publicPages()).map(page => page.route));
+  assert.equal(entries.length, routes.size);
+  for (const entry of entries) {
+    assert.ok(routes.has(entry.href));
+    assert.ok(!unlistedRoutes.has(entry.href));
+    assert.doesNotMatch(entry.href, /^\/(?:private|sandbox|contact-inbox)(?:\/|$)/);
+  }
+  for (const entry of newsroomStories) assert.ok(routes.has(entry.href.split('#')[0]));
+});
