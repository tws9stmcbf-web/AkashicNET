+++ b/worker/homesense899-preferences.mjs
@@ -0,0 +1,87 @@
+import { countries, languages } from "../public/scripts/homesense899-preference-options.mjs";
+import { filofaxOwner } from "./filofax.mjs";
+
+const submitPath = "/api/homesense899/preferences";
+const reportPath = "/contact-inbox/homesense899-preferences";
+const headers = { "Cache-Control": "private, no-store", "X-Robots-Tag": "noindex, nofollow" };
+const commentLifetime = 30 * 24 * 60 * 60;
+const increment = `INSERT INTO homesense899_preference_totals (kind, code, submissions)
+  VALUES (?, ?, 1) ON CONFLICT (kind, code)
+  DO UPDATE SET submissions = submissions + 1`;
+
+export async function homesense899Preferences(request, env) {
+  const url = new URL(request.url);
+  const today = Math.floor(Date.now() / 86400000) * 86400;
+  if (url.pathname === reportPath) {
+    if (!filofaxOwner(request, env)) return new Response(null, { status: 403, headers });
+    if (request.method === "DELETE") {
+      const id = Number(url.searchParams.get("comment"));
+      if (request.headers.get("Origin") !== url.origin || !Number.isSafeInteger(id) || id < 1) {
+        return new Response(null, { status: 400, headers });
+      }
+      await env.DB.prepare("DELETE FROM homesense899_preference_comments WHERE id = ?").bind(id).run();
+      return new Response(null, { status: 204, headers });
+    }
+    if (request.method !== "GET") return new Response(null, { status: 405, headers });
+    try {
+      const [, totals, comments] = await env.DB.batch([
+        env.DB.prepare("DELETE FROM homesense899_preference_comments WHERE expires_at <= ?").bind(today),
+        env.DB.prepare("SELECT kind, code, submissions FROM homesense899_preference_totals ORDER BY kind, submissions DESC, code"),
+        env.DB.prepare("SELECT id, comment, expires_at FROM homesense899_preference_comments ORDER BY id DESC"),
+      ]);
+      return Response.json({ submissionsByPreference: totals.results, comments: comments.results }, { headers });
+    } catch {
+      return new Response(null, { status: 503, headers });
+    }
+  }
+  if (url.pathname !== submitPath) return null;
+  if (request.method !== "POST") return new Response(null, { status: 405, headers });
+  if (request.headers.get("Origin") !== url.origin ||
+      request.headers.get("Content-Type") !== "application/json") {
+    return new Response(null, { status: 403, headers });
+  }
+  const reader = request.body?.getReader();
+  if (!reader) return new Response(null, { status: 400, headers });
+  let submitted;
+  try {
+    const decoder = new TextDecoder();
+    let body = "";
+    let bytes = 0;
+    for (;;) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      bytes += value.byteLength;
+      if (bytes > 512) {
+        await reader.cancel();
+        return new Response(null, { status: 413, headers });
+      }
+      body += decoder.decode(value, { stream: true });
+    }
+    submitted = JSON.parse(body + decoder.decode());
+  } catch {
+    return new Response(null, { status: 400, headers });
+  }
+  if (!submitted || Object.keys(submitted).length !== 5 || submitted.adult !== true ||
+      submitted.consent !== true || !countries.includes(submitted.country) ||
+      !languages.includes(submitted.language) || typeof submitted.comment !== "string" ||
+      submitted.comment.length > 40 || /[\u0000-\u001F\u007F]/.test(submitted.comment)) {
+    return new Response(null, { status: 400, headers });
+  }
+  try {
+    const statements = [
+      env.DB.prepare(increment).bind("country", submitted.country),
+      env.DB.prepare(increment).bind("language", submitted.language),
+      env.DB.prepare("DELETE FROM homesense899_preference_comments WHERE expires_at <= ?").bind(today),
+    ];
+    const comment = submitted.comment.trim();
+    if (comment) {
+      statements.push(env.DB.prepare(
+        "INSERT INTO homesense899_preference_comments (comment, expires_at) VALUES (?, ?)"
+      ).bind(comment, today + commentLifetime));
+    }
+    await env.DB.batch(statements);
+    return new Response(null, { status: 204, headers });
+  } catch {
+    return new Response(null, { status: 503, headers });
+  }
+}
