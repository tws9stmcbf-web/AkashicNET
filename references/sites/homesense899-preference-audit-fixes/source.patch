diff --git a/public/scripts/homesense899-sharing.mjs b/public/scripts/homesense899-sharing.mjs
new file mode 100644
index 00000000..210ada04
--- /dev/null
+++ b/public/scripts/homesense899-sharing.mjs
@@ -0,0 +1,89 @@
+const retryWindow = 23 * 60 * 60 * 1000;
+const retryExplanation = " Retry uses your original choices because the first request may have succeeded.";
+
+function addOptions(select, codes, type) {
+  const names = typeof Intl.DisplayNames === "function" ? new Intl.DisplayNames(["en"], { type }) : null;
+  const labels = codes.map(code => [code, code === "other" ? "Other" : names?.of(code) ?? code]);
+  labels.sort((a, b) => a[1].localeCompare(b[1], "en"));
+  for (const [code, label] of labels) select.add(new Option(label, code));
+}
+
+export function setupPreferenceSharing(form, countries, languages) {
+  const residence = form.querySelector("[data-residence]");
+  const language = form.querySelector("[data-preferred-language]");
+  const status = form.querySelector('[role="status"]');
+  const submit = form.querySelector('[type="submit"]');
+  const dismiss = form.querySelector("[data-dismiss-preferences]");
+  addOptions(residence, countries, "region");
+  addOptions(language, languages, "language");
+
+  let payload;
+  let firstAttempt;
+  let uncertain = false;
+  let retryAt = 0;
+  const editable = () => { residence.disabled = false; language.disabled = false; };
+  dismiss.addEventListener("click", () => {
+    if (submit.disabled && !submit.hidden) return;
+    form.reset();
+    form.hidden = true;
+    document.querySelector("#intimacy-talk h3").focus();
+  });
+  form.addEventListener("submit", async event => {
+    event.preventDefault();
+    if (submit.disabled || !form.reportValidity()) return;
+    const now = Date.now();
+    if (now < retryAt) {
+      status.textContent = `Please retry after ${new Date(retryAt).toLocaleTimeString()}.` + (uncertain ? retryExplanation : " Your choices have not been added by this attempt.");
+      return;
+    }
+    firstAttempt ??= now;
+    if (now - firstAttempt >= retryWindow) {
+      status.textContent = "The safe retry window has closed. Your first submission may have been recorded. You can continue watching without sharing again.";
+      submit.hidden = true;
+      return;
+    }
+    payload ??= { adult: true, consent: true, country: residence.value, language: language.value, submissionId: crypto.randomUUID() };
+    residence.disabled = true;
+    language.disabled = true;
+    submit.disabled = true;
+    dismiss.disabled = true;
+    status.textContent = "Saving your preferences…";
+    try {
+      const response = await fetch("/api/homesense899/preferences", {
+        method: "POST", credentials: "omit", headers: { "Content-Type": "application/json" },
+        body: JSON.stringify(payload), signal: AbortSignal.timeout(8000),
+      });
+      if (response.status === 204) {
+        status.textContent = "Your preferences were recorded. You can continue watching.";
+        submit.hidden = true;
+        dismiss.textContent = "Continue to the Talk";
+        return;
+      }
+      // A rejection only proves this attempt did not write. It cannot settle an earlier timeout.
+      if ([400, 413, 415, 429].includes(response.status) && !uncertain) {
+        payload = undefined;
+        firstAttempt = undefined;
+        editable();
+      }
+      if (response.status === 429) {
+        const seconds = Number(response.headers.get("Retry-After"));
+        retryAt = Date.now() + (Number.isFinite(seconds) && seconds > 0 ? seconds : 3600) * 1000;
+        status.textContent = `The form has reached its hourly limit. Retry after ${new Date(retryAt).toLocaleTimeString()}.` + (uncertain ? retryExplanation : " Your choices have not been added by this attempt.");
+      } else if ([400, 413, 415].includes(response.status) && !uncertain) {
+        status.textContent = "These preferences were not recorded. Check your choices and try again.";
+      } else {
+        uncertain = true;
+        status.textContent = "We could not confirm recording your preferences." + retryExplanation;
+      }
+    } catch {
+      uncertain = true;
+      status.textContent = "We could not confirm recording your preferences." + retryExplanation;
+    } finally {
+      submit.disabled = false;
+      dismiss.disabled = false;
+      if (uncertain) dismiss.textContent = "Continue to the Talk";
+    }
+    submit.textContent = uncertain ? "Retry Original Preferences" : "Share Preferences";
+  });
+  form.hidden = false;
+}
