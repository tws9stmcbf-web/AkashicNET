+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { runInNewContext } from 'node:vm';
+import test from 'node:test';
+
+function sharingFixture(responses) {
+  let now = Date.UTC(2026, 10, 19, 12);
+  let serial = 0;
+  let focused = false;
+  const requests = [];
+  const residence = { value: 'DE', disabled: false, add() {} };
+  const language = { value: 'pa', disabled: false, add() {} };
+  const status = { textContent: '' };
+  const submit = { disabled: false, hidden: false, textContent: 'Share Preferences' };
+  const dismiss = { disabled: false, addEventListener: (_event, fn) => { dismiss.click = fn; } };
+  const form = {
+    hidden: true,
+    querySelector: selector => ({ '[data-residence]': residence, '[data-preferred-language]': language, '[role="status"]': status, '[type="submit"]': submit, '[data-dismiss-preferences]': dismiss })[selector],
+    reportValidity: () => true,
+    reset: () => { residence.value = ''; language.value = ''; },
+    addEventListener: (_event, fn) => { form.send = () => fn({ preventDefault() {} }); },
+  };
+  class Clock extends Date { static now() { return now; } }
+  const source = readFileSync(new URL('../public/scripts/homesense899-sharing.mjs', import.meta.url), 'utf8').replace('export function setupPreferenceSharing', 'function setupPreferenceSharing');
+  const setup = runInNewContext(source + '\nsetupPreferenceSharing;', {
+    Date: Clock, Intl, Option: class {}, AbortSignal,
+    document: { querySelector: () => ({ focus: () => { focused = true; } }) },
+    crypto: { randomUUID: () => `key-${++serial}` },
+    fetch: async (_url, request) => {
+      requests.push(JSON.parse(request.body));
+      const next = responses.shift();
+      if (next instanceof Error) throw next;
+      return new Response(null, { status: next.status, headers: next.headers });
+    },
+  });
+  setup(form, ['DE', 'GB'], ['pa', 'en']);
+  return { form, residence, language, submit, dismiss, status, requests, advance: ms => { now += ms; }, focused: () => focused };
+}
+
+test('ambiguous retries preserve the same key and payload even after a later rejection', async () => {
+  const ui = sharingFixture([new Error('timeout'), { status: 400 }, { status: 204 }]);
+  await ui.form.send();
+  assert.match(ui.status.textContent, /original choices/);
+  assert.equal(ui.residence.disabled, true);
+  ui.residence.value = 'GB';
+  await ui.form.send();
+  assert.equal(ui.residence.disabled, true);
+  await ui.form.send();
+  assert.deepEqual(ui.requests[0], ui.requests[1]);
+  assert.deepEqual(ui.requests[1], ui.requests[2]);
+  assert.equal(ui.requests[2].country, 'DE');
+  assert.equal(ui.submit.hidden, true);
+  assert.equal(ui.dismiss.disabled, false);
+  assert.equal(ui.dismiss.textContent, 'Continue to the Talk');
+});
+
+test('definitive quota rejection honours Retry-After and allows correction', async () => {
+  const ui = sharingFixture([{ status: 429, headers: { 'Retry-After': '60' } }, { status: 204 }]);
+  await ui.form.send();
+  assert.equal(ui.residence.disabled, false);
+  assert.match(ui.status.textContent, /not been added/);
+  ui.residence.value = 'GB';
+  await ui.form.send();
+  assert.equal(ui.requests.length, 1);
+  ui.advance(60000);
+  await ui.form.send();
+  assert.equal(ui.requests.length, 2);
+  assert.equal(ui.requests[1].country, 'GB');
+  assert.notEqual(ui.requests[0].submissionId, ui.requests[1].submissionId);
+});
+
+test('safe retry deadline stops an ambiguous request before server receipt expiry', async () => {
+  const ui = sharingFixture([new Error('timeout')]);
+  await ui.form.send();
+  ui.advance(23 * 60 * 60 * 1000);
+  await ui.form.send();
+  assert.equal(ui.requests.length, 1);
+  assert.equal(ui.submit.hidden, true);
+  assert.match(ui.status.textContent, /safe retry window has closed/);
+});
+
+test('skipping clears unsent fields, returns focus and makes no request', () => {
+  const ui = sharingFixture([]);
+  ui.dismiss.click();
+  assert.equal(ui.form.hidden, true);
+  assert.equal(ui.residence.value, '');
+  assert.equal(ui.language.value, '');
+  assert.equal(ui.focused(), true);
+  assert.equal(ui.requests.length, 0);
+});
