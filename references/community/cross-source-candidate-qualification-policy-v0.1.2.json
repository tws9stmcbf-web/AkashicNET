{
  "policy_version": "0.1.2",
  "scope": "cross-source-candidate-qualification",
  "candidate_defaults": {
    "assertion_class": "INFERRED_CANDIDATE",
    "review_state": "REVIEW_REQUIRED",
    "accepted_edge": false
  },
  "qualification": {
    "direct_anchor_types": [
      "EXPLICIT_IDENTIFIER",
      "EXACT_FULL_TITLE",
      "EXPLICIT_CITATION"
    ],
    "corroborating_anchor_types": [
      "DISTINCTIVE_NAMED_ENTITY",
      "DISTINCTIVE_MULTI_TOKEN_PHRASE",
      "EXPLICIT_FRAMEWORK_REFERENCE",
      "EXPLICIT_QUESTION_REFERENCE"
    ],
    "direct_anchor_minimum": 1,
    "corroborating_anchor_minimum": 2,
    "corroborating_anchors_must_be_distinct": true,
    "generic_terms_cannot_qualify_alone": true,
    "generic_terms": [
      "sacred",
      "wisdom",
      "tradition",
      "symbolism",
      "interpretation",
      "consciousness",
      "meaning",
      "spiritual",
      "knowledge",
      "magic"
    ],
    "graph_derived_anchors_allowed": false,
    "representation_count_as_anchor_allowed": false,
    "reverse_edge_as_anchor_allowed": false
  },
  "boundaries": {
    "private_drive_metadata_allowed": false,
    "automated_truth_inference_allowed": false,
    "automated_acceptance_allowed": false,
    "rights_promotion_allowed": false,
    "scientific_evidence_promotion_allowed": false,
    "canonical_identity_promotion_allowed": false,
    "circular_confidence_allowed": false
  }
}
