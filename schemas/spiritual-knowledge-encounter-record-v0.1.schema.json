{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akashicnet.org/schemas/spiritual-knowledge-encounter-record-v0.1.schema.json",
  "title": "AkashicNET Spiritual Knowledge & Encounter Record v0.1",
  "description": "A provenance-first record for spiritual knowledge, ritual context and anomalous or other-being encounters. Presence in the archive is not scientific or metaphysical validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "record_kind",
    "title",
    "evidence_lane",
    "provenance",
    "cultural_governance",
    "claims",
    "interpretation_boundary",
    "verification",
    "safety"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "record_id": {
      "type": "string",
      "pattern": "^SKER-[A-Z0-9][A-Z0-9-]+$"
    },
    "record_kind": {
      "enum": [
        "tradition_teaching",
        "ritual_practice",
        "first_person_encounter",
        "community_testimony",
        "historical_text",
        "empirical_study",
        "comparative_synthesis"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "evidence_lane": {
      "enum": [
        "established_evidence",
        "interpretation",
        "lived_experience_or_testimony",
        "traditional_knowledge",
        "hypothesis",
        "speculation",
        "mixed_separated"
      ]
    },
    "related_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^BQ[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "related_frameworks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "tradition_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tradition": {
          "type": [
            "string",
            "null"
          ]
        },
        "people_or_nation": {
          "type": [
            "string",
            "null"
          ]
        },
        "community": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "territory": {
          "type": [
            "string",
            "null"
          ]
        },
        "lineage_or_school": {
          "type": [
            "string",
            "null"
          ]
        },
        "original_term": {
          "type": [
            "string",
            "null"
          ]
        },
        "translation": {
          "type": [
            "string",
            "null"
          ]
        },
        "knowledge_holder": {
          "type": [
            "string",
            "null"
          ]
        },
        "living_tradition": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ritual_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "practice": {
          "type": [
            "string",
            "null"
          ]
        },
        "intended_function": {
          "type": "array",
          "items": {
            "enum": [
              "healing",
              "initiation",
              "divination",
              "mourning",
              "ancestor_relationship",
              "social_cohesion",
              "ecological_reciprocity",
              "identity_transformation",
              "liberation",
              "other"
            ]
          },
          "uniqueItems": true
        },
        "setting": {
          "type": [
            "string",
            "null"
          ]
        },
        "individual_or_group": {
          "enum": [
            "individual",
            "group",
            "unknown"
          ]
        },
        "facilitator_role": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration": {
          "type": [
            "string",
            "null"
          ]
        },
        "rhythm_or_sound": {
          "type": [
            "string",
            "null"
          ]
        },
        "breath_or_movement": {
          "type": [
            "string",
            "null"
          ]
        },
        "substances": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "consent_recorded": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "encounter_phenomenology": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state_context": {
          "enum": [
            "waking",
            "dream",
            "lucid_dream",
            "meditation",
            "near_death",
            "sleep_paralysis",
            "ritual_trance",
            "psychedelic",
            "mediumship",
            "other",
            "not_applicable"
          ]
        },
        "perceived_presence": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "perceived_identity": {
          "type": [
            "string",
            "null"
          ]
        },
        "perceived_autonomy": {
          "type": [
            "string",
            "null"
          ]
        },
        "communication_mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "communication_content": {
          "type": [
            "string",
            "null"
          ]
        },
        "emotional_tone": {
          "type": [
            "string",
            "null"
          ]
        },
        "bodily_sensations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "time_distortion": {
          "type": [
            "string",
            "null"
          ]
        },
        "self_boundary_change": {
          "type": [
            "string",
            "null"
          ]
        },
        "memory_quality": {
          "type": [
            "string",
            "null"
          ]
        },
        "immediate_aftereffects": {
          "type": [
            "string",
            "null"
          ]
        },
        "long_term_aftereffects": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provenance_id",
          "original_url_or_locator",
          "retrieved_at",
          "source_type",
          "preserve_original"
        ],
        "properties": {
          "original_url_or_locator": {
            "type": "string",
            "minLength": 1
          },
          "retrieved_at": {
            "type": "string",
            "format": "date"
          },
          "source_type": {
            "enum": [
              "primary_community_source",
              "knowledge_holder",
              "participant_account",
              "traditional_text",
              "translation",
              "archive",
              "peer_reviewed_study",
              "secondary_analysis",
              "media",
              "unknown"
            ]
          },
          "creator_or_custodian": {
            "type": [
              "string",
              "null"
            ]
          },
          "publication_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "translation_details": {
            "type": [
              "string",
              "null"
            ]
          },
          "chain_of_custody": {
            "type": [
              "string",
              "null"
            ]
          },
          "preserve_original": {
            "const": true
          },
          "availability": {
            "enum": [
              "available",
              "access_limited",
              "unavailable",
              "unknown"
            ]
          },
          "content_hash": {
            "type": [
              "string",
              "null"
            ]
          },
          "provenance_id": {
            "type": "string",
            "pattern": "^PROV-[A-Z0-9][A-Z0-9-]+$"
          }
        }
      }
    },
    "cultural_governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "care_review",
        "authority_to_control",
        "permission_status",
        "reproduction_status"
      ],
      "properties": {
        "care_review": {
          "enum": [
            "completed",
            "required",
            "not_applicable",
            "unknown"
          ]
        },
        "collective_benefit": {
          "type": [
            "string",
            "null"
          ]
        },
        "authority_to_control": {
          "type": [
            "string",
            "null"
          ]
        },
        "responsibility": {
          "type": [
            "string",
            "null"
          ]
        },
        "ethics_notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "permission_status": {
          "enum": [
            "explicit_permission",
            "public_with_attribution",
            "community_review_required",
            "restricted",
            "unknown"
          ]
        },
        "reproduction_status": {
          "enum": [
            "permitted",
            "metadata_only",
            "quotation_limited",
            "do_not_reproduce",
            "unknown"
          ]
        },
        "benefit_sharing": {
          "type": [
            "string",
            "null"
          ]
        },
        "cultural_sensitivity": {
          "enum": [
            "open",
            "context_required",
            "sensitive",
            "sacred_or_restricted",
            "unknown"
          ]
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "claim",
          "claim_type",
          "attributed_to",
          "support_level",
          "evidence_lane",
          "provenance_ids"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "claim_type": {
            "enum": [
              "descriptive",
              "historical",
              "therapeutic",
              "phenomenological",
              "ethical",
              "spiritual",
              "metaphysical",
              "predictive"
            ]
          },
          "attributed_to": {
            "type": "string"
          },
          "support_level": {
            "enum": [
              "documented_source",
              "participant_report",
              "community_attestation",
              "measured_association",
              "experimental_support",
              "contested",
              "unverified",
              "not_testable_presently"
            ]
          },
          "testable": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "claim_id": {
            "type": "string",
            "pattern": "^CLAIM-[A-Z0-9][A-Z0-9-]+$"
          },
          "evidence_lane": {
            "enum": [
              "established_evidence",
              "interpretation",
              "lived_experience_or_testimony",
              "traditional_knowledge",
              "hypothesis",
              "speculation"
            ]
          },
          "provenance_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^PROV-[A-Z0-9][A-Z0-9-]+$"
            }
          }
        }
      }
    },
    "interpretation_boundary": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "neutral_description",
            "source_interpretation",
            "akashicnet_assessment"
          ],
          "properties": {
            "neutral_description": {
              "type": "string",
              "minLength": 1
            },
            "source_interpretation": {
              "type": "string",
              "minLength": 1
            },
            "akashicnet_assessment": {
              "type": "string",
              "minLength": 1
            },
            "ordinary_explanations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "metaphysical_interpretations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "non_equivalence_notes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "content_withheld",
            "withholding_reason"
          ],
          "properties": {
            "content_withheld": {
              "const": true
            },
            "withholding_reason": {
              "enum": [
                "metadata_only",
                "do_not_reproduce"
              ]
            }
          }
        }
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prospective_record",
        "results",
        "excluded_authentication_targets"
      ],
      "properties": {
        "prospective_record": {
          "type": "boolean"
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "verification_id",
              "target_type",
              "target_id",
              "status",
              "independent_provenance_ids",
              "outcome"
            ],
            "properties": {
              "verification_id": {
                "type": "string",
                "pattern": "^VERIFY-[A-Z0-9][A-Z0-9-]+$"
              },
              "target_type": {
                "enum": [
                  "claim",
                  "phenomenon"
                ]
              },
              "target_id": {
                "type": "string",
                "minLength": 1,
                "description": "A claim_id or a bounded phenomenon identifier. It must never identify a perceived being."
              },
              "status": {
                "enum": [
                  "not_attempted",
                  "in_progress",
                  "partially_verified",
                  "verified_specific_information",
                  "not_verified",
                  "falsified_specific_claim",
                  "undetermined"
                ]
              },
              "independent_provenance_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^PROV-[A-Z0-9][A-Z0-9-]+$"
                }
              },
              "blinding": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "information_leakage_review": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "failed_matches_recorded": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "outcome": {
                "type": "string",
                "minLength": 1
              },
              "next_discriminating_test": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "enum": [
                        "partially_verified",
                        "verified_specific_information",
                        "not_verified",
                        "falsified_specific_claim"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "independent_provenance_ids": {
                      "minItems": 1
                    }
                  }
                }
              }
            ]
          }
        },
        "excluded_authentication_targets": {
          "type": "array",
          "uniqueItems": true,
          "allOf": [
            {
              "contains": {
                "const": "perceived_identity"
              }
            },
            {
              "contains": {
                "const": "perceived_entity_existence"
              }
            }
          ],
          "items": {
            "enum": [
              "perceived_identity",
              "perceived_entity_existence",
              "record_wide_metaphysical_interpretation"
            ]
          }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "not_medical_advice",
        "do_not_authenticate_entities",
        "support_person_without_forcing_belief"
      ],
      "properties": {
        "not_medical_advice": {
          "const": true
        },
        "do_not_authenticate_entities": {
          "const": true
        },
        "support_person_without_forcing_belief": {
          "const": true
        },
        "acute_risk_notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "consent_or_coercion_notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "vulnerable_people_notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "governance_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content_withheld": {
      "const": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "cultural_governance": {
            "properties": {
              "care_review": {
                "enum": [
                  "required",
                  "unknown"
                ]
              }
            },
            "required": [
              "care_review"
            ]
          }
        },
        "required": [
          "cultural_governance"
        ]
      },
      "then": {
        "properties": {
          "cultural_governance": {
            "properties": {
              "permission_status": {
                "enum": [
                  "community_review_required",
                  "restricted",
                  "unknown"
                ]
              },
              "reproduction_status": {
                "enum": [
                  "metadata_only",
                  "do_not_reproduce",
                  "unknown"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cultural_governance": {
            "properties": {
              "permission_status": {
                "enum": [
                  "community_review_required",
                  "restricted",
                  "unknown"
                ]
              }
            },
            "required": [
              "permission_status"
            ]
          }
        },
        "required": [
          "cultural_governance"
        ]
      },
      "then": {
        "properties": {
          "cultural_governance": {
            "properties": {
              "reproduction_status": {
                "enum": [
                  "metadata_only",
                  "do_not_reproduce",
                  "unknown"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cultural_governance": {
            "properties": {
              "reproduction_status": {
                "enum": [
                  "permitted",
                  "quotation_limited"
                ]
              }
            },
            "required": [
              "reproduction_status"
            ]
          }
        },
        "required": [
          "cultural_governance"
        ]
      },
      "then": {
        "properties": {
          "cultural_governance": {
            "required": [
              "authority_to_control"
            ],
            "properties": {
              "care_review": {
                "enum": [
                  "completed",
                  "not_applicable"
                ]
              },
              "authority_to_control": {
                "type": "string",
                "minLength": 1
              },
              "permission_status": {
                "enum": [
                  "explicit_permission",
                  "public_with_attribution"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cultural_governance": {
            "properties": {
              "permission_status": {
                "const": "explicit_permission"
              }
            },
            "required": [
              "permission_status"
            ]
          }
        },
        "required": [
          "cultural_governance"
        ]
      },
      "then": {
        "properties": {
          "cultural_governance": {
            "required": [
              "authority_to_control"
            ],
            "properties": {
              "care_review": {
                "const": "completed"
              },
              "authority_to_control": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cultural_governance": {
            "properties": {
              "reproduction_status": {
                "enum": [
                  "metadata_only",
                  "do_not_reproduce"
                ]
              }
            },
            "required": [
              "reproduction_status"
            ]
          }
        },
        "required": [
          "cultural_governance"
        ]
      },
      "then": {
        "required": [
          "content_withheld"
        ],
        "properties": {
          "summary": false,
          "tradition_context": false,
          "ritual_context": false,
          "encounter_phenomenology": false,
          "claims": {
            "maxItems": 0
          },
          "interpretation_boundary": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "content_withheld",
              "withholding_reason"
            ],
            "properties": {
              "content_withheld": {
                "const": true
              },
              "withholding_reason": {
                "enum": [
                  "metadata_only",
                  "do_not_reproduce"
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "content_withheld": false,
          "claims": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
