{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "question_id",
    "question_status",
    "status",
    "promotion_guards",
    "sources",
    "review",
    "limitations"
  ],
  "properties": {
    "contract_version": {
      "const": "0.18.0-pilot.1"
    },
    "question_id": {
      "const": "BQ001"
    },
    "question_status": {
      "const": "UNRESOLVED"
    },
    "status": {
      "enum": [
        "HOLD",
        "SYNTHETIC_NOT_FOR_PUBLICATION",
        "HUMAN_CLEARED_METADATA_PREVIEW_NOT_PUBLISHED"
      ]
    },
    "promotion_guards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "truth",
        "evidence",
        "rights",
        "identity",
        "edge_acceptance"
      ],
      "properties": {
        "truth": {
          "const": false
        },
        "evidence": {
          "const": false
        },
        "rights": {
          "const": false
        },
        "identity": {
          "const": false
        },
        "edge_acceptance": {
          "const": false
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "original_url",
          "current_url",
          "kind",
          "reading_depth",
          "evidence_status",
          "observation_sha256",
          "corrections"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "original_url": {
            "type": "string",
            "format": "uri"
          },
          "current_url": {
            "type": "string",
            "format": "uri"
          },
          "kind": {
            "enum": [
              "primary_research",
              "community_citation"
            ]
          },
          "reading_depth": {
            "type": "string",
            "minLength": 1
          },
          "evidence_status": {
            "type": "string",
            "minLength": 1
          },
          "observation_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "corrections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "observation_id",
                "supersedes",
                "observed_at",
                "observation_sha256"
              ],
              "properties": {
                "observation_id": {
                  "type": "string",
                  "minLength": 1
                },
                "supersedes": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "observed_at": {
                  "type": "string",
                  "format": "date"
                },
                "observation_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    },
    "review": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "review_id",
            "state",
            "recorded_at",
            "review_sha256"
          ],
          "properties": {
            "review_id": {
              "type": "string",
              "minLength": 1
            },
            "state": {
              "enum": [
                "HUMAN_REVIEWED",
                "SIMULATED_REVIEW"
              ]
            },
            "recorded_at": {
              "type": "string",
              "format": "date"
            },
            "review_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "input_revision": {
      "type": "integer",
      "minimum": 1
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akashicnet.org/schemas/research-integration-public-v0.18.schema.json",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "HOLD"
          }
        }
      },
      "then": {
        "properties": {
          "sources": {
            "maxItems": 0
          },
          "review": {
            "type": "null"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "input_revision"
              ]
            },
            {
              "required": [
                "input_sha256"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "input_revision",
          "input_sha256"
        ],
        "properties": {
          "sources": {
            "minItems": 2,
            "maxItems": 2
          },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "review_id",
              "state",
              "recorded_at",
              "review_sha256"
            ],
            "properties": {
              "review_id": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "enum": [
                  "HUMAN_REVIEWED",
                  "SIMULATED_REVIEW"
                ]
              },
              "recorded_at": {
                "type": "string",
                "format": "date"
              },
              "review_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  ]
}
